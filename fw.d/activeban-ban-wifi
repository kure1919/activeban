#!/bin/sh
# activeban external command: Wi-Fi association refusal (OpenWrt hostapd)
# Contract: arguments = MAC IP TTL_SECONDS; exit 0 = success, non-zero = failure.
# Target settings live in /etc/activeban/fw-target.conf:
#   FW_HOST / FW_USER / FW_KEY, optional WIFI_IFACES (default: "wlan0 wlan1")
#
# Adds the MAC to hostapd's deny ACL and deauthenticates it if connected.
# This excludes the device from that AP entirely, including LAN traffic.
# Notes:
# - The deny ACL is runtime state and disappears when hostapd restarts.
# - It only affects clients associated with this AP. A client that roams to
#   another vendor's mesh node is outside this command's reach.
# - TTL is managed by the activeban daemon; hostapd has no per-entry TTL here.
# - Success is judged from hostapd_cli's replies, never assumed: the
#   control channel must answer PONG and deny_acl ADD_MAC must answer OK.
#   (An earlier version appended "; true" and discarded all output, which
#   reported success even when hostapd was down or the ACL add failed.)
# - If one interface fails, the rest are still attempted; the pair as a
#   whole reports failure, and a later release cleans up partial state.
set -eu
CONF="${ACTIVEBAN_TARGET_CONF:-/etc/activeban/fw-target.conf}"
# shellcheck disable=SC1090
. "$CONF"
MAC="$(echo "$1" | tr 'A-F' 'a-f')"
echo "$MAC" | grep -Eq '^[0-9a-f]{2}(:[0-9a-f]{2}){5}$' \
  || { echo "bad mac: $1" >&2; exit 64; }
IFACES="${WIFI_IFACES:-wlan0 wlan1}"
FAILED=0
for IF in $IFACES; do
  OUT="$(ssh -i "$FW_KEY" -o BatchMode=yes -o StrictHostKeyChecking=yes \
    "$FW_USER@$FW_HOST" -- \
    "P=\$(hostapd_cli -i $IF ping 2>/dev/null); [ \"\$P\" = PONG ] || exit 3; A=\$(hostapd_cli -i $IF deny_acl ADD_MAC $MAC 2>/dev/null); [ \"\$A\" = OK ] || exit 4; hostapd_cli -i $IF deauthenticate $MAC >/dev/null 2>&1; echo OK" \
    2>/dev/null)" || OUT=""
  [ "$OUT" = "OK" ] || FAILED=1
done
[ "$FAILED" -eq 0 ]
