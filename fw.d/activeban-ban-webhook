#!/bin/sh
# activeban external command: webhook (BAN).
# Contract: arguments = MAC IP TTL_SECONDS; exit 0 = success, non-zero = failure.
# Target settings live in /etc/activeban/fw-target.conf:
#   WEBHOOK_BAN_URL      URL POSTed to when a ban takes effect
#   WEBHOOK_RELEASE_URL  URL POSTed to when a ban is released (release pair)
#   WEBHOOK_HEADER       optional, one extra header line, e.g.
#                        "Authorization: Bearer <redacted>"
#
# The request body is JSON:
#   {"action": "ban", "mac": "...", "ip": "...", "ttl_seconds": 21600}
#
# This pair is the generic escape hatch for enforcement that does not
# fit the router/AP scripts: a Home Assistant webhook that switches a
# smart plug off, a call to a managed switch's API, a message to a
# human who unplugs things by hand - anything with an HTTP endpoint.
# What the far end does with the event is entirely up to it.
#
# Notes:
# - Requires curl and python3. Any HTTP status >= 400 counts as failure
#   (curl -f), so the daemon will not record a ban the far end
#   rejected. Redirects (3xx) are NOT followed and count as success
#   only in the sense that the endpoint answered; point the URL at the
#   final endpoint. An HTTP success also cannot prove the far end
#   actually enforced anything - that is the endpoint's contract.
# - The JSON body is built with python3's json module, not by string
#   concatenation, so quoting/escaping is never hand-rolled.
# - WEBHOOK_HEADER is passed through a curl config file with mode 600
#   (removed on exit), never as a -H argument: command-line arguments
#   are visible to every local user via the process list.
# - TTL expiry is driven by the daemon, which calls the release pair;
#   the webhook itself does not need to honour the TTL.
# - Be careful who can reach the far-end URL: it now holds ban power
#   over your devices. Keep it on the LAN or behind authentication.
set -eu
CONF="${ACTIVEBAN_TARGET_CONF:-/etc/activeban/fw-target.conf}"
# shellcheck disable=SC1090
. "$CONF"

if [ "$#" -ne 3 ]; then
  echo "usage: activeban-ban-webhook MAC IP TTL_SECONDS" >&2
  exit 64
fi
MAC="$1"
IP="$2"
TTL_SECONDS="$3"
echo "$MAC" | grep -Eq '^[0-9A-Fa-f]{2}(:[0-9A-Fa-f]{2}){5}$' \
  || { echo "bad mac: $MAC" >&2; exit 64; }
case "$TTL_SECONDS" in
  *[!0-9]* | "") echo "bad ttl: $TTL_SECONDS" >&2; exit 64 ;;
esac

BODY="$(AB_ACTION=ban AB_MAC="$MAC" AB_IP="$IP" AB_TTL="$TTL_SECONDS" \
  python3 -c 'import json, os; print(json.dumps({"action": os.environ["AB_ACTION"], "mac": os.environ["AB_MAC"], "ip": os.environ["AB_IP"], "ttl_seconds": int(os.environ["AB_TTL"])}))')"

if [ -n "${WEBHOOK_HEADER:-}" ]; then
  CURL_CONF="$(mktemp)"
  chmod 600 "$CURL_CONF"
  trap 'rm -f "$CURL_CONF"' EXIT
  printf 'header = "%s"\n' \
    "$(printf '%s' "$WEBHOOK_HEADER" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')" \
    > "$CURL_CONF"
  curl -fsS -m 10 -K "$CURL_CONF" -X POST \
    -H 'Content-Type: application/json' \
    -d "$BODY" "$WEBHOOK_BAN_URL" >/dev/null
else
  curl -fsS -m 10 -X POST -H 'Content-Type: application/json' \
    -d "$BODY" "$WEBHOOK_BAN_URL" >/dev/null
fi
