#!/bin/sh
# activeban external command: release a Wi-Fi association refusal (hostapd)
# Contract: arguments = MAC IP; exit 0 = success, non-zero = failure.
# Removing a MAC that is not in the deny ACL is success (idempotent).
# Target settings live in /etc/activeban/fw-target.conf:
#   FW_HOST / FW_USER / FW_KEY, optional WIFI_IFACES (default: "wlan0 wlan1")
set -eu
CONF="${ACTIVEBAN_TARGET_CONF:-/etc/activeban/fw-target.conf}"
# shellcheck disable=SC1090
. "$CONF"
MAC="$(echo "$1" | tr 'A-F' 'a-f')"
IFACES="${WIFI_IFACES:-wlan0 wlan1}"
FAILED=0
for IF in $IFACES; do
  ssh -i "$FW_KEY" -o BatchMode=yes -o StrictHostKeyChecking=yes \
    "$FW_USER@$FW_HOST" -- \
    "hostapd_cli -i $IF deny_acl DEL_MAC $MAC >/dev/null 2>&1; true" \
    || FAILED=1
done
[ "$FAILED" -eq 0 ]
