#!/bin/sh
# activeban external command: release an OpenWrt nftables ban
# Contract: arguments = MAC IP; exit 0 = success, non-zero = failure.
# A missing element is success (idempotent), including an element that
# already expired through its nft timeout. Target settings: fw-target.conf.
set -eu
CONF="${ACTIVEBAN_TARGET_CONF:-/etc/activeban/fw-target.conf}"
# shellcheck disable=SC1090
. "$CONF"
MAC="$(echo "$1" | tr 'A-F' 'a-f')"
SSH="ssh -i $FW_KEY -o BatchMode=yes -o StrictHostKeyChecking=yes $FW_USER@$FW_HOST --"
# Establish reachability first so an SSH failure is not mistaken for an
# already-expired element.
$SSH true
$SSH "if nft list element inet activeban quarantine '{ $MAC }' >/dev/null 2>&1; then nft delete element inet activeban quarantine '{ $MAC }'; fi"
